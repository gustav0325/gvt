{#- Tema inicial da barra vem da página (front matter navTema: claro), já no
    HTML: Obras e Contato abrem sobre fundo branco e a barra nasce clara no
    primeiro frame, sem esperar o main.js nem passar pela transição do vidro.
    Sem navTema, nasce no estado base (o do Hero). Depois, ao rolar, o main.js
    segue trocando o tema pelas seções, como antes. #}
<header class="navbar{% if navTema %} navbar--{{ navTema }}{% endif %}">
  <div class="navbar__inner">
    <a class="navbar__logo" href="/" aria-label="GVT Cortes e Furos — página inicial">
      {# O Figma traz duas versões do logo: texto claro sobre o Hero (6:41) e
         texto escuro sobre seções claras (22:174). Alternadas com a navbar. #}
      <img class="navbar__logo-img navbar__logo-img--padrao" src="/assets/img/global/logo-gvt.svg" width="159" height="66" alt="GVT Cortes e Furos">
      <img class="navbar__logo-img navbar__logo-img--invertido" src="/assets/img/global/logo-gvt-fundo-claro.svg" width="159" height="66" alt="" aria-hidden="true">
    </a>

    <nav class="nav" aria-label="Menu principal">
      <a class="nav__link {% if activeNav == 'inicio' %}nav__link--active{% endif %}" href="/">INICIO</a>
      <a class="nav__link {% if activeNav == 'sobre-nos' %}nav__link--active{% endif %}" href="/sobre-nos/">SOBRE NÓS</a>
      <a class="nav__link {% if activeNav == 'servicos' %}nav__link--active{% endif %}" href="/servicos/">SERVIÇOS</a>
      <a class="nav__link {% if activeNav == 'obras' %}nav__link--active{% endif %}" href="/obras/">OBRAS</a>
      <a class="nav__link {% if activeNav == 'contato' %}nav__link--active{% endif %}" href="/contato/">CONTATO</a>
    </nav>

    {# Mobile (≤1023px): o menu acima some e entra o hambúrguer #}
    <button class="navbar__menu-botao" type="button" aria-expanded="false" aria-controls="menu-mobile" aria-label="Abrir menu">
      <span class="navbar__menu-linha" aria-hidden="true"></span>
      <span class="navbar__menu-linha" aria-hidden="true"></span>
      <span class="navbar__menu-linha" aria-hidden="true"></span>
    </button>
  </div>
</header>
{% if navTemaMobile %}
{#- Tema inicial só do celular (front matter navTemaMobile): a Sobre Nós abre
    com a barra clara sobre a faixa branca antes do hero, no desktop não.
    Aplicado aqui, antes do primeiro paint; depois o main.js segue as seções. #}
<script>
  (function () {
    if (!window.matchMedia("(max-width: 1023px)").matches) return;
    document.querySelector(".navbar").classList.add("navbar--{{ navTemaMobile }}");
  })();
</script>
{% endif %}
{% if ancoras %}
{#- Tema calculado no <head> para a #âncora (base.njk): aplicado aqui, antes
    do primeiro paint e sem transição #}
<script>
  (function () {
    var tema = document.documentElement.getAttribute("data-nav-ancora");
    if (!tema) return;
    var navbar = document.querySelector(".navbar");
    navbar.classList.add("navbar--direta");
    navbar.classList.remove("navbar--claro", "navbar--escuro");
    if (tema !== "base") navbar.classList.add("navbar--" + tema);
  })();
</script>
{% endif %}

{#- Menu mobile. Fica FORA do <header>: o backdrop-filter da navbar faria dela
    o bloco de contenção de um elemento fixed, e o menu ficaria preso aos 88px
    da barra. Os itens levam às seções da Home. #}
<nav class="menu-mobile" id="menu-mobile" aria-label="Menu" inert>
  <ul class="menu-mobile__lista">
    <li><a class="menu-mobile__link" href="/#inicio">Início</a></li>
    <li><a class="menu-mobile__link" href="/#sobre">Sobre nós</a></li>
    <li><a class="menu-mobile__link" href="/#servicos">Serviços</a></li>
    <li><a class="menu-mobile__link" href="/#obras">Obras</a></li>
    <li><a class="menu-mobile__link" href="/#contato">Contato</a></li>
  </ul>
</nav>
